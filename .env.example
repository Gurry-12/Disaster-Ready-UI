# Environment Variables Configuration
# Copy this file to .env and fill in your actual values
# NEVER commit .env to version control!

# Application Environment
NODE_ENV=development

# API Configuration
API_URL=http://localhost:3000/api
AUTH_API_URL=http://localhost:3000/auth

# Google Maps API Key
# Get your key from: https://console.cloud.google.com/google/maps-apis
# IMPORTANT: Restrict this key to your domain in Google Cloud Console
GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here

# Security
# Generate a strong random secret for JWT signing
JWT_SECRET=your_jwt_secret_here
CSRF_SECRET=your_csrf_secret_here

# Session Configuration
SESSION_SECRET=your_session_secret_here
SESSION_TIMEOUT=3600

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# Logging
LOG_LEVEL=info
ENABLE_DEBUG_LOGS=false

# External Services (if applicable)
SENTRY_DSN=
ANALYTICS_ID=

# Database (if applicable)
DATABASE_URL=

# Email Service (if applicable)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=

# Feature Flags
ENABLE_REAL_TIME_ALERTS=true
ENABLE_LIVE_MAP=true
ENABLE_INCIDENT_REPORTING=true
ENABLE_RESOURCE_MANAGEMENT=true
ENABLE_ANALYTICS=true
